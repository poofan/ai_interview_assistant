# Backend Environment Variables

# App
APP_NAME=Hintsage Backend
DEBUG=False

# Database
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/hintsage
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hintsage

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256

# Email (Yandex SMTP для РФ)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=noreply@smartsobes.ru
SMTP_PASSWORD=your-email-password
EMAIL_FROM=Hintsage <noreply@smartsobes.ru>

# Банк Точка
TOCHKA_API_URL=https://enter.tochka.com/uapi/acquiring/v1.0
TOCHKA_BEARER_TOKEN=your-tochka-bearer-token
TOCHKA_CUSTOMER_CODE=300000092
TOCHKA_MERCHANT_ID=200000000001056
TOCHKA_TAX_SYSTEM_CODE=osn

# Subscription Prices (в рублях)
PRICE_PRO_MONTHLY=1499.00
PRICE_PRO_YEARLY=14990.00
PRICE_ENTERPRISE_MONTHLY=7490.00
PRICE_ENTERPRISE_YEARLY=74900.00

# Frontend
FRONTEND_URL=https://smartsobes.ru

# CORS
CORS_ORIGINS=["http://localhost:3000", "https://smartsobes.ru", "https://www.smartsobes.ru"]

